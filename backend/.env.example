# NASA C-MAPSS Predictive Maintenance - Environment Configuration
# Copy this file to .env and populate with your credentials.

# API Environment & Debugging
DEBUG=false

# Supabase Credentials (from your Supabase Project Settings -> API)
# Required for persistent cloud database storage.
# If omitted, the backend runs seamlessly using in-memory storage fallback.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-optional

# Custom Artifact Overrides (defaults to backend/artifacts/)
# MODEL_PATH=backend/artifacts/lstm_model.keras
# SCALER_PATH=backend/artifacts/scaler.joblib

# Phase 4: Configurable Risk Thresholds (Operational flight cycles)
# Prototype decision-support rules for academic evaluation; not certified aviation limits.
RISK_THRESHOLD_CRITICAL=25.0
RISK_THRESHOLD_WARNING=50.0
RISK_THRESHOLD_MODERATE=80.0

# Phase 4: Maintenance Scheduling Constraints
DEFAULT_HANGAR_CAPACITY=2
DEFAULT_MAINTENANCE_LEAD_TIME=5

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
