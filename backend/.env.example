# NASA C-MAPSS Predictive Maintenance - Environment Configuration
# Copy this file to .env and populate with your credentials.

# API Environment
DEBUG=false

# Supabase Credentials (from your Supabase Project Settings -> API)
# Required for persistent cloud database storage.
# If omitted, the backend runs seamlessly using in-memory storage fallback.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-optional

# Custom Artifact Overrides (defaults to backend/artifacts/)
# MODEL_PATH=backend/artifacts/lstm_model.keras
# SCALER_PATH=backend/artifacts/scaler.joblib
