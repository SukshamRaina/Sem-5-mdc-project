# ====================================================================
# Git Ignore Configuration - NASA C-MAPSS Predictive Maintenance Project
# ====================================================================

# 1. Environment Variables and Secrets (CRITICAL: Never commit credentials)
.env
.env.*
backend/.env
backend/.env.*
*.env
*.env.*
!.env.example
!backend/.env.example

# 2. Python Bytecode, Caches & Testing
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 3. Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# 4. Frontend & Node.js (Phase 3)
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. IDEs and Operating System Artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# 6. Logs & Scratch
*.log
scratch/
